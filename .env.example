# Template for local environment variables.
# Copy it to ".env" (same folder) and put real values there.
# ".env" is ignored by git: real secrets never go in the repository.

# --- PostgreSQL for local development (infra/docker-compose.dev.yml) ---
POSTGRES_DB=posture_studio
POSTGRES_USER=posture_studio
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# --- Can be omitted when in local ---
POSTGRES_HOST=localhost

# --- PROVISIONAL until step 9: simulated payments (POST /api/dev/bookings/{id}/payment-authorized) ---
# Local development only. Leave it out (or false) everywhere else: it confirms bookings without paying
BOOKING_SIMULATED_PAYMENTS=true

# --- Email (step 8). Local: Mailpit from infra/docker-compose.dev.yml, received emails on http://localhost:8025 ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_FROM=no-reply@posture-studio.local
# the address of the site, for the links in the emails (guide 27, 6.6). Optional: default http://localhost:3000
APP_URL=http://localhost:3000

# --- Push notifications (step 8, guide 28, part 5): the VAPID key pair, the private key is a SECRET ---
# Generate the pair together, from backend/: java tools/GenerateVapidKeys.java
# Without them the application does not start. Changing them invalidates every registered device
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# a contact for the push services (mailto: or https:). Optional: default mailto:no-reply@posture-studio.local
VAPID_SUBJECT=mailto:no-reply@posture-studio.local

# --- SMS (step 8, guide 29, part 6) ---
# DEVELOPMENT ONLY: the access codes by SMS arrive as emails in Mailpit (http://localhost:8025),
# to sms-<number>@sms.local. Never true in production. Without it the SMS sign-in answers 503
SMS_TO_MAILPIT=true

# --- Access codes (step 8, guide 24, part 3): the HMAC key of the codes, a SECRET ---
# Base64 of at least 32 random bytes. Generate one with: openssl rand -base64 32
# (PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b))
# Never Get-Random: it is not a cryptographic generator
AUTH_CODE_HMAC_KEY=

# --- The first admin (step 8, guide 26, part 2): the email of whoever manages the platform (D-021) ---
# Not a secret, but personal data: real value only in .env. At startup the ADMIN account of this email is
# created if missing; an email that already belongs to a customer or a practitioner stops the startup.
# Empty: no admin is created
ADMIN_EMAIL=
