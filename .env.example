# Template for local environment variables.
# Copy it to ".env" (same folder) and put real values there.
# ".env" is ignored by git: real secrets never go in the repository.

# --- PostgreSQL for local development (infra/docker-compose.dev.yml) ---
POSTGRES_DB=posture_studio
POSTGRES_USER=posture_studio
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
