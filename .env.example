# Template for local environment variables.
# Copy it to ".env" (same folder) and put real values there.
# ".env" is ignored by git: real secrets never go in the repository.

# --- PostgreSQL for local development (infra/docker-compose.dev.yml) ---
POSTGRES_DB=posture_studio
POSTGRES_USER=posture_studio
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# --- Can be omitted when in local ---
POSTGRES_HOST=localhost

# --- PROVISIONAL until step 9: simulated payments (POST /api/dev/bookings/{id}/payment-authorized) ---
# Local development only. Leave it out (or false) everywhere else: it confirms bookings without paying
BOOKING_SIMULATED_PAYMENTS=true
